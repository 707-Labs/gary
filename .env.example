# Identity
GARY_LINEAR_USER_ID=
GARY_NAME=Gary

# Linear
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_IN_PROGRESS_STATE_ID=

# GitHub (App-based, default)
GITHUB_APP_ID=
# Either point at the .pem file OR paste the key contents inline (with literal \n
# escapes for newlines). _PATH wins if both are set.
GITHUB_APP_PRIVATE_KEY_PATH=~/.gary/secrets/gary-707-labs.pem
# GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_USERNAME=gary-707-labs[bot]

# GitHub (user-based, alternative — leave GITHUB_APP_ID empty to use this)
# GITHUB_PAT=
# GITHUB_USERNAME=gary-707labs

# GLM via Z.ai
Z_AI_API_KEY=
Z_AI_BASE_URL=https://api.z.ai/api/anthropic
Z_AI_MODEL=glm-4.6

# Cloudflare Workers Observability (optional — when set, Gary gets log-search
# tools for the production app). Token needs Account → Workers Observability
# (Read). Account ID is the same one wrangler deploys to.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Comma-separated worker names. Defaults to the mulligan-labs worker family.
# CLOUDFLARE_OBSERVABILITY_WORKERS=mulligan-labs,mulligan-labs-party,mulligan-labs-feedback,mulligan-labs-discord-bot
# Read-only D1 access for the agent's `d1_query` tool. alias=uuid pairs.
# Defaults to the mulligan-labs db ID from ertai/wrangler.json. Token needs
# Account → D1 (Read) in addition to Workers Observability (Read).
# CLOUDFLARE_D1_DATABASES=mulligan-labs=d0d963f1-53dd-4f57-b24d-b3fb3da56753

# Runtime
POLL_INTERVAL_MS=60000
MAX_ATTEMPTS_PER_TICKET=5
CIRCUIT_BREAKER_WINDOW_HOURS=6
MAX_CI_ATTEMPTS=3
AGENT_LOOP_MAX_ITERATIONS=50
AGENT_LOOP_TIMEOUT_MS=900000
# How long an open, idle, CI-green PR can sit before Gary nudges the reviewer
# on the Linear ticket. Default 72h matches voice.md example 14 ("3 days").
STALE_PR_HOURS=72

# Paths (defaults shown; override only if you need to)
GARY_HOME=~/.gary
GARY_STATE_DIR=~/.gary/state
GARY_REPOS_DIR=~/.gary/repos
GARY_WORKSPACES_DIR=~/.gary/workspaces

# Repo map: <TEAM_KEY>:<owner>/<repo>, comma-separated. Each Linear team
# Gary handles needs an entry here. Tickets from teams not in the map
# are skipped silently. All repos in the same GitHub org share one App
# installation.
GARY_REPO_MAP=ERT:707-Labs/ertai,GREEN:707-Labs/green-ledger,BIRD:707-Labs/birdup

# Comma-separated Linear user ids permitted to summon Gary via @mention on
# tickets he's not assigned to. Empty (default) disables the @mention
# pipeline. Strict triggers ("@gary take this") self-assign; plain @mentions
# get a one-shot answer. See src/mention.ts.
# GARY_ALLOWLISTED_MENTION_USER_IDS=

# Logging
LOG_LEVEL=info
