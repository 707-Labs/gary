# Identity
GARY_LINEAR_USER_ID=
GARY_NAME=Gary

# Linear
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_IN_PROGRESS_STATE_ID=

# GitHub (App-based, default)
GITHUB_APP_ID=
# Either point at the .pem file OR paste the key contents inline (with literal \n
# escapes for newlines). _PATH wins if both are set.
GITHUB_APP_PRIVATE_KEY_PATH=~/.gary/secrets/gary-707-labs.pem
# GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_USERNAME=gary-707-labs[bot]

# GitHub (user-based, alternative — leave GITHUB_APP_ID empty to use this)
# GITHUB_PAT=
# GITHUB_USERNAME=gary-707labs

# GLM via Z.ai (required — the chain won't boot without it)
Z_AI_API_KEY=
Z_AI_BASE_URL=https://api.z.ai/api/anthropic
Z_AI_MODEL=glm-5.2

# Kimi Code (optional provider; needed for the default main-work routing).
# NOTE: Kimi Code != Moonshot Open Platform — different billing surface.
# K3 is a reasoning model (thinking block before text), so single-turn
# completions need max_tokens headroom.
# KIMI_API_KEY=
# KIMI_MODEL=k3

# DeepSeek (optional provider; default reviewer-pass primary)
# DEEPSEEK_API_KEY=

# Per-action-type provider routing. Main work (classify, coding, answers)
# prefers Kimi K3; PR follow-ups (CI fixes, review responses, stale-PR
# nudges) prefer Z.ai GLM. Unknown names are dropped; unconfigured
# providers are skipped, so main work falls back to GLM if KIMI_API_KEY
# is unset. Defaults shown.
# GARY_MAIN_PROVIDER_ORDER=kimi,z.ai,deepseek
# GARY_PR_FOLLOWUP_PROVIDER_ORDER=z.ai,kimi,deepseek

# Cloudflare Workers Observability (optional — when set, Gary gets log-search
# tools for the production app). Token needs Account → Workers Observability
# (Read). Account ID is the same one wrangler deploys to.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Comma-separated worker names. Defaults to the mulligan-labs worker family.
# CLOUDFLARE_OBSERVABILITY_WORKERS=mulligan-labs,mulligan-labs-party,mulligan-labs-feedback,mulligan-labs-discord-bot
# Read-only D1 access for the agent's `d1_query` tool. alias=uuid pairs.
# Defaults to the mulligan-labs db ID from ertai/wrangler.json. Token needs
# Account → D1 (Read) in addition to Workers Observability (Read).
# CLOUDFLARE_D1_DATABASES=mulligan-labs=d0d963f1-53dd-4f57-b24d-b3fb3da56753

# Runtime
POLL_INTERVAL_MS=60000
MAX_ATTEMPTS_PER_TICKET=5
CIRCUIT_BREAKER_WINDOW_HOURS=6
MAX_CI_ATTEMPTS=3
AGENT_LOOP_MAX_ITERATIONS=50
AGENT_LOOP_TIMEOUT_MS=900000

# Post-finish test gate. In addition to `bun run check`, the gate runs the
# target repo's tests before the reviewer pass. Unset = autodetect from the
# worktree's package.json (`test:run` first, then `test` if it's a non-watch
# invocation). Set a command to force it, or "off" to disable.
# GARY_TEST_COMMAND=

# Agent-loop phase budgets per classified scope, "<investigate>/<implement>"
# iterations. Defaults shown; malformed values fall back to defaults.
# GARY_PHASE_BUDGET_S=12/25
# GARY_PHASE_BUDGET_M=20/45
# GARY_PHASE_BUDGET_L=20/50
# How long an open, idle, CI-green PR can sit before Gary nudges the reviewer
# on the Linear ticket. Default 72h matches voice.md example 14 ("3 days").
STALE_PR_HOURS=72

# Paths (defaults shown; override only if you need to)
GARY_HOME=~/.gary
GARY_STATE_DIR=~/.gary/state
GARY_REPOS_DIR=~/.gary/repos
GARY_WORKSPACES_DIR=~/.gary/workspaces

# Repo map: <TEAM_KEY>:<owner>/<repo>, comma-separated. Each Linear team
# Gary handles needs an entry here. Tickets from teams not in the map
# are skipped silently. All repos in the same GitHub org share one App
# installation.
# NOTE: existing deployments should keep the name their `prs` rows were
# recorded under — the loop matches stored repo strings against this map,
# so renaming an entry strands open-PR tracking (ertai → mulligan-labs
# still resolves via GitHub's rename redirect).
GARY_REPO_MAP=ERT:707-Labs/mulligan-labs,GREEN:707-Labs/green-ledger,BIRD:707-Labs/birdup

# Comma-separated Linear user ids permitted to summon Gary via @mention on
# tickets he's not assigned to. Empty (default) disables the @mention
# pipeline. Strict triggers ("@gary take this") self-assign; plain @mentions
# get a one-shot answer. See src/mention.ts.
# GARY_ALLOWLISTED_MENTION_USER_IDS=

# Reviewer pass: a fresh agent that reviews the primary's diff before
# push. Catches half-wired features, untested logic, and unverified
# claims. All optional.
GARY_REVIEWER_PROVIDER_ORDER=deepseek,z.ai,kimi
GARY_REVIEW_MAX_ROUNDS=3
GARY_REVIEW_ITERATION_CAP=15
GARY_REVIEW_TIMEOUT_MS=300000
# Reviewer mandates run in parallel each round. Both roles cost ~2x reviewer
# tokens per round; set to `correctness` to fall back to the single pre-split
# reviewer without a code change.
GARY_REVIEW_ROLES=correctness,adversarial

# Logging
LOG_LEVEL=info
