<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for ~/Library/LaunchAgents/com.707labs.gary.plist on the Mac that runs Gary.
  scripts/deploy.sh renders it: __GARY_RELEASE__ becomes the current HEAD, which
  src/readonly-startup.ts requires to match the checked-out tree exactly.
  Paths and SHA pins are the reviewed deployment; change them only with a new review.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.707labs.gary</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/tanner/.bun/bin/bun</string>
    <string>run</string>
    <string>src/index.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/tanner/Developer/gary</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- Don't churn if Gary keeps crashing; back off 30s between restarts. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/Users/tanner/Library/Logs/gary/stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/tanner/Library/Logs/gary/stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/tanner/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/tanner</string>

    <!-- Hermes runtime: pinned Docker executor, no network. -->
    <key>GARY_RUNTIME_MODE</key>
    <string>hermes-canary</string>
    <key>GARY_CONVERSATION_RUNTIME_RELEASE</key>
    <string>__GARY_RELEASE__</string>
    <key>GARY_EXECUTOR</key>
    <string>docker</string>
    <key>GARY_EXECUTOR_IMAGE</key>
    <string>sha256:0efb49a8f21794948395f7bec2c15557a78473acd760207613fe7714e7c47f8c</string>
    <key>GARY_EXECUTOR_NETWORK</key>
    <string>none</string>
    <key>GARY_BUN_CACHE_VOLUME</key>
    <string>gary-bun-cache-20261007-node24</string>
    <key>DOCKER_HOST</key>
    <string>unix:///Users/tanner/.colima/default/docker.sock</string>
    <key>DOCKER_CONTEXT</key>
    <string></string>
    <key>GARY_HERMES_ACTIVATION_PATH</key>
